# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files (contain sensitive data)
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Terraform lock file
.terraform.lock.hcl

# Terraform directory
.terraform/

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment variables
.env
