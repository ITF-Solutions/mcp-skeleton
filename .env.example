# MCP Mode: stdio, http, or worker
MCP_MODE=http

# HTTP server configuration (for http mode)
PORT=3000
HOST=localhost

# Storage configuration (for worker mode)
# ENCRYPTION_KEY=your-32-char-secret-key-here

# OAuth configuration (for worker mode with OAUTH_ENABLED=true)
# See docs/oauth.md for setup guide
# ACCESS_CLIENT_ID=
# ACCESS_CLIENT_SECRET=
# ACCESS_TOKEN_URL=
# ACCESS_AUTHORIZATION_URL=
# ACCESS_JWKS_URL=
# COOKIE_ENCRYPTION_KEY=

# Add your custom environment variables here
