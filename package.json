{
  "name": "mcp-skeleton",
  "version": "1.0.0",
  "description": "Template for building multi-mode MCP servers (stdio, HTTP/SSE, Cloudflare Workers)",
  "private": false,
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "node ./dist/cli.js",
    "mcp:stdio": "node ./dist/cli.js",
    "mcp:http": "node ./dist/http-server.js",
    "dev": "tsx watch ./src/cli.ts",
    "dev:http": "tsx watch ./src/http-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "template",
    "skeleton",
    "cloudflare-workers",
    "stdio",
    "http",
    "sse"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "hono": "^4.11.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250304.0",
    "@hono/node-server": "^1.13.7",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.91.0"
  }
}
