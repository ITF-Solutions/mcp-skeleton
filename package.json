{
  "name": "mcp-skeleton",
  "version": "1.0.0",
  "description": "Template for building multi-mode MCP servers (stdio, HTTP, Cloudflare Workers)",
  "private": false,
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "node ./dist/cli.js",
    "mcp:stdio": "node ./dist/cli.js",
    "mcp:http": "node ./dist/http-server.js",
    "dev": "tsx watch ./src/cli.ts",
    "dev:http": "tsx watch ./src/http-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "template",
    "skeleton",
    "cloudflare-workers",
    "stdio",
    "http",
    "streamable-http"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.11.9",
    "hono": "^4.12.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250304.0",
    "@hono/node-server": "^2.0.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  }
}
